{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource for Hide Mail outbound metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "id": null,
  "uid": "hidemail-outbound",
  "title": "Hide Mail - Outbound Send",
  "description": "Per-account outbound Send volume, delivery, caps, DNS and queue health",
  "tags": ["hide-mail", "outbound", "prometheus"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(hidemail_outbound_accepted_total, account)",
        "hide": 0,
        "includeAll": true,
        "multi": false,
        "name": "account",
        "options": [],
        "query": { "query": "label_values(hidemail_outbound_accepted_total, account)", "refId": "A" },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(hidemail_outbound_accepted_total{account=~\"$account\"}, domain)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "domain",
        "options": [],
        "query": {
          "query": "label_values(hidemail_outbound_accepted_total{account=~\"$account\"}, domain)",
          "refId": "A"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Volume & delivery",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "title": "Accepted / delivered / deferred / bounced rates",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(hidemail_outbound_accepted_total{account=~\"$account\",domain=~\"$domain\"}[5m])) by (domain)",
          "legendFormat": "accepted {{domain}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(hidemail_outbound_delivered_total{account=~\"$account\",domain=~\"$domain\"}[5m])) by (domain)",
          "legendFormat": "delivered {{domain}}",
          "refId": "B"
        },
        {
          "expr": "sum(rate(hidemail_outbound_deferred_total{account=~\"$account\",domain=~\"$domain\"}[5m])) by (domain)",
          "legendFormat": "deferred {{domain}}",
          "refId": "C"
        },
        {
          "expr": "sum(rate(hidemail_outbound_bounced_total{account=~\"$account\",domain=~\"$domain\"}[5m])) by (domain)",
          "legendFormat": "bounced {{domain}}",
          "refId": "D"
        },
        {
          "expr": "sum(rate(hidemail_outbound_held_total{account=~\"$account\",domain=~\"$domain\"}[5m])) by (domain)",
          "legendFormat": "held {{domain}}",
          "refId": "E"
        },
        {
          "expr": "sum(rate(hidemail_outbound_rejected_total{account=~\"$account\",domain=~\"$domain\"}[5m])) by (domain)",
          "legendFormat": "rejected {{domain}}",
          "refId": "F"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "id": 2,
      "title": "Delivery rate",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rate(hidemail_outbound_delivered_total{account=~\"$account\",domain=~\"$domain\"}[1h])) / clamp_min(sum(rate(hidemail_outbound_accepted_total{account=~\"$account\",domain=~\"$domain\"}[1h])), 0.0001)",
          "legendFormat": "delivered/accepted",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops", "stacking": { "mode": "normal" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "id": 3,
      "title": "Bounce rate by category",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(hidemail_outbound_bounced_total{account=~\"$account\",domain=~\"$domain\"}[5m])) by (category)",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Caps, suppressions, queue",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 10 },
      "id": 4,
      "title": "Cap usage (daily_sent / daily_limit)",
      "type": "gauge",
      "targets": [
        {
          "expr": "hidemail_outbound_daily_sent{account=~\"$account\",domain=~\"$domain\"} / clamp_max(hidemail_outbound_daily_limit{account=~\"$account\",domain=~\"$domain\"}, 1e12)",
          "legendFormat": "{{domain}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 10 },
      "id": 5,
      "title": "Suppressions by reason",
      "type": "timeseries",
      "targets": [
        {
          "expr": "hidemail_outbound_suppressions{account=~\"$account\"}",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 10 },
      "id": 6,
      "title": "Queue depth",
      "type": "timeseries",
      "targets": [
        {
          "expr": "hidemail_outbound_queued{account=~\"$account\",domain=~\"$domain\"}",
          "legendFormat": "{{domain}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 102,
      "title": "DNS & consumer health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "not verified" },
                "1": { "color": "green", "text": "verified" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 18 },
      "id": 7,
      "title": "Domain verified",
      "type": "stat",
      "targets": [
        {
          "expr": "hidemail_outbound_domain_verified{account=~\"$account\",domain=~\"$domain\"}",
          "legendFormat": "{{domain}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 18 },
      "id": 8,
      "title": "DNS check outcomes",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(hidemail_outbound_dns_check_total{account=~\"$account\",domain=~\"$domain\"}[1h])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "FAIL" },
                "1": { "color": "green", "text": "OK" }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 18 },
      "id": 9,
      "title": "Operator DNS",
      "type": "stat",
      "targets": [
        {
          "expr": "hidemail_outbound_operator_dns_ok",
          "legendFormat": "{{check}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 18 },
      "id": 10,
      "title": "Event consumer lag",
      "type": "stat",
      "targets": [
        {
          "expr": "hidemail_outbound_event_consumer_lag",
          "legendFormat": "lag",
          "refId": "A"
        }
      ]
    }
  ]
}
